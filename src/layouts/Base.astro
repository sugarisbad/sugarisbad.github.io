---
// Шрифты — self-hosted (Fontsource): без запросов к Google CDN на критическом пути.
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { brand, contacts } from '../data/site';
import { t, localeUrl, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Путь страницы без префикса локали: '' | 'cases/' | 'services/' | 'work/'. */
  path?: string;
  /** true — страница вне индекса (404 и т.п.): noindex, без canonical/hreflang. */
  noindex?: boolean;
  /** Вариант фоновой анимации: home — 3 линии + пятно, services — 1 линия, page — 2 линии. */
  bg?: 'home' | 'page' | 'services';
  /** OG-превью страницы (путь от корня). Не задано — общий /og.jpg. */
  ogImage?: string;
}
const { title, description, locale = 'ru', path = '', noindex = false, bg = 'page', ogImage: ogPath } = Astro.props;
const dict = t(locale);

const site = (Astro.site?.href ?? 'https://opsmith.ru/').replace(/\/$/, '');
const urlRu = `${site}${localeUrl('ru', path)}`;
const urlEn = `${site}${localeUrl('en', path)}`;
const canonical = locale === 'ru' ? urlRu : urlEn;
const ogImage = `${site}${ogPath ?? '/og.jpg'}`;

// Микроразметка сайта и бренда OPSMITH.
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: dict.seo.siteName,
  url: `${site}/`,
  inLanguage: [{ '@type': 'Language', name: 'Russian', alternateName: 'ru' }, { '@type': 'Language', name: 'English', alternateName: 'en' }],
};
// Бренд как организация: связывает страницы в единый сущностный граф
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: brand,
  description: dict.home.desc,
  url: `${site}/`,
  logo: `${site}/icon-512.png`,
  image: ogImage,
  email: `mailto:${contacts.email}`,
  priceRange: locale === 'ru' ? '3 600 ₽ – 192 000 ₽' : '$40 – $2,100',
  areaServed: 'Worldwide',
};
// Хлебные крошки для подстраниц
const crumbNames: Record<string, string> = {
  'cases/': dict.nav.cases,
  'services/': dict.nav.services,
  'work/': dict.nav.work,
};
const breadcrumbLd =
  !noindex && path && crumbNames[path]
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: dict.nav.home, item: `${site}${localeUrl(locale, '')}` },
          { '@type': 'ListItem', position: 2, name: crumbNames[path], item: canonical },
        ],
      }
    : null;
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <!-- Тема — по местному времени посетителя: 07–19 светлая, иначе тёмная.
         Скрипт инлайновый и стоит до контента, чтобы не было мигания темы. -->
    <script is:inline>
      (function () {
        var meta;
        function applyTheme() {
          var h = new Date().getHours();
          var theme = h >= 7 && h < 19 ? 'light' : 'dark';
          if (document.documentElement.getAttribute('data-theme') === theme) return;
          document.documentElement.setAttribute('data-theme', theme);
          meta = meta || document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f5f2ea' : '#0b0b0d');
        }
        applyTheme();
        // Вкладка может жить сутками — проверяем границу дня раз в минуту.
        setInterval(applyTheme, 60000);
      })();
    </script>
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="ru" href={urlRu} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlRu} />
      </>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="OPSMITH" href={locale === 'ru' ? '/rss.xml' : '/en/rss.xml'} />

    <!-- Подтверждение прав в поисковиках (дублирует DNS TXT-записи) -->
    <meta name="yandex-verification" content="915cbe8fccc35863" />
    <meta name="google-site-verification" content="6aBHVruKpFLw0bY4eI_yQXoe3fEzUv3gnknT7Rs3Rw8" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.seo.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.seo.ogImageAlt} />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}


    <slot name="head" />
  </head>
  <body>
    <!-- Фоновая анимация: кривые Безье + вертикальные волосяные линии -->
    <div class="bg" aria-hidden="true">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
        <path
          d="M -60 620 C 330 570 560 680 930 600 S 1400 500 1560 550"
          fill="none"
          stroke="var(--accent)"
          stroke-width="1"
          opacity={bg === 'home' ? '.3' : bg === 'services' ? '.22' : '.26'}
          stroke-dasharray="800"
          style="animation:lineflow 12s linear infinite"
        />
        {bg === 'home' && (
          <path
            d="M -60 680 C 400 640 660 730 1010 660 S 1420 570 1560 610"
            fill="none"
            stroke="var(--muted)"
            stroke-width="1"
            opacity=".18"
            stroke-dasharray="800"
            style="animation:lineflow 16s linear infinite"
          />
        )}
        {bg !== 'services' && (
          <path
            d="M -60 200 C 360 240 640 150 980 210 S 1420 290 1560 250"
            fill="none"
            stroke="var(--muted)"
            stroke-width="1"
            opacity=".12"
            stroke-dasharray="800"
            style="animation:lineflow 20s linear infinite"
          />
        )}
        {bg === 'home' && (
          <>
            <circle cx="930" cy="600" r="3" fill="var(--accent)" opacity=".85" />
            <circle cx="560" cy="655" r="2.5" fill="var(--accent)" opacity=".45" />
            <circle cx="980" cy="210" r="2.5" fill="var(--accent)" opacity=".4" />
          </>
        )}
      </svg>
      <div class="bg-cols"></div>
      {bg === 'home' && <div class="bg-spot"></div>}
    </div>

    <div class="page">
      <slot />
    </div>
    <Analytics locale={locale} />

  </body>
</html>
