---
// Услуги и цены: hero, калькулятор заказа и описания направлений DevOps.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Calculator from '../components/Calculator.astro';
import Footer from '../components/Footer.astro';
import { PRICING } from '../data/pricing';
import { t, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ru' } = Astro.props;
const dict = t(locale);

// Каталог услуг с ценами для поисковиков.
const offersLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: dict.servicesPage.title,
  itemListElement: PRICING.flatMap((g) =>
    g.items.map((it) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: locale === 'ru' ? it.name_ru : it.name_en },
      price: it.rub,
      priceCurrency: 'RUB',
    }))
  ),
};
---

<Base title={dict.servicesPage.title} description={dict.servicesPage.desc} locale={locale} path="services/" bg="services" ogImage={`/og/services${locale === 'en' ? '-en' : ''}.jpg`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(offersLd)} />

  <Header locale={locale} path="services/" active="services" cta="call" />

  <section class="hero-services">
    <div class="wrap">
      <span class="kicker fx">{dict.servicesPage.kicker}</span>
      <h1 class="h1 fx-1" set:html={dict.servicesPage.h1} />
      <p class="lead fx-2">{dict.servicesPage.sub}</p>
      <div class="cta-row fx-3">
        <a href="#calc" class="btn btn-primary">{dict.servicesPage.ctaCalc}</a>
        <a href="#directions" class="btn btn-ghost">{dict.servicesPage.ctaDetails}</a>
      </div>
      {locale === 'en' && (
        <p class="rate-note fx-2" id="rate-note" data-text={dict.servicesPage.rateNote}>{dict.servicesPage.rateNote}</p>
      )}
    </div>
  </section>

  <Calculator locale={locale} />

  <section class="section" id="directions" aria-labelledby="directions-title">
    <div class="wrap">
      <div class="svc-head">
        <div>
          <span class="kicker">{dict.servicesPage.directionsKicker}</span>
          <h2 class="h2" id="directions-title" set:html={dict.servicesPage.directionsH2} />
        </div>
        <p class="lead">{dict.servicesPage.directionsLead}</p>
      </div>
      <div class="tiles service-details">
        {dict.servicesPage.directions.map((service) => (
          <article class="principle">
            <span class="num">/ {service.num}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
      <div class="svc-btns">
        <a href="#calc" class="btn btn-primary">{dict.servicesPage.directionsCta}</a>
      </div>
    </div>
  </section>

  <Footer locale={locale} flush />
</Base>

<style>
  .service-details { row-gap: 2rem; }
</style>
