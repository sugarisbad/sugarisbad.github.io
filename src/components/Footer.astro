---
import { brand, contacts } from '../data/site';
import { localeUrl, type Locale } from '../i18n';
import { t } from '../i18n';
import LogoMark from './LogoMark.astro';

interface Props {
  locale?: Locale;
  /** true — без верхнего отступа (страница услуг: секция сама даёт паддинг). */
  flush?: boolean;
}
const { locale = 'ru', flush = false } = Astro.props;
const dict = t(locale);
const base = import.meta.env.BASE_URL;
---

<footer class={flush ? 'flush' : undefined}>
  <div class="wrap foot">
    <a class="brand" href={localeUrl(locale, '', base)}><LogoMark size={17} />{brand}</a>
    <span class="foot-links">
      <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
      <a href={locale === 'ru' ? '/rss.xml' : '/en/rss.xml'}>RSS</a>
      <a href={localeUrl(locale, 'privacy/')}>{locale === 'ru' ? 'Персональные данные' : 'Privacy policy'}</a>
      <button hidden data-analytics-settings>{locale === 'ru' ? 'Настройки аналитики' : 'Analytics settings'}</button>
    </span>
    <span class="tag">{dict.footer.tagline}</span>
  </div>
</footer>
<style>
  .foot, .foot-links { flex-wrap:wrap; }
  button { background:none; color:inherit; font:inherit; padding:0; border:0; cursor:pointer; }
  button:hover { color:var(--accent); }
</style>
